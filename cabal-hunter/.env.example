# ── Cabal-Hunter MCP Server — Environment Config ──────────────────────────────

# Port for the Express REST + MCP server
PORT=8080

# Your Helius RPC endpoint (same as the bot)
HELIUS_RPC_URL=https://babbie-zbfwal-fast-mainnet.helius-rpc.com
HELIUS_API_KEY=your-helius-api-key-here

# Receiving wallet for USDC payments (RECOMMEND: a dedicated wallet, not the trading wallet)
# This is the Solana address that receives $0.05 USDC per query
RECEIVING_WALLET=YOUR_SOLANA_WALLET_ADDRESS_HERE

# USDC mint on Solana mainnet (do not change)
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# Price per query in USDC (e.g. 0.05 = $0.05)
PRICE_PER_QUERY_USDC=0.05

# Shared secret for the internal bridge to the Python bot
# Generate with: openssl rand -hex 32
CABAL_INTERNAL_SECRET=change-me-to-a-random-secret

# URL of the Python bot's internal API (same server, different port)
BOT_INTERNAL_URL=http://127.0.0.1:3001

# Path to the shared SQLite cache written by the Python bot
# Absolute path on the server
CABAL_CACHE_DB=/home/ubuntu/eliza/packages/python/elizaos/plugins/solana/cabal_cache.db

# MCP Server name shown to clients
MCP_SERVER_NAME=cabal-hunter
MCP_SERVER_VERSION=1.0.0

# Environment: production | development
NODE_ENV=production
