{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Canonical schema for all objects in the Polymarket decision pipeline",

  "definitions": {

    "BrainOutput": {
      "type": "object",
      "required": ["summary", "probability_yes", "confidence", "suggested_action"],
      "properties": {
        "brain_name": { "type": "string" },
        "summary": { "type": "string" },
        "probability_yes": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "time_horizon": { "type": "string" },
        "key_evidence": { "type": "array", "items": { "type": "string" } },
        "risks": { "type": "array", "items": { "type": "string" } },
        "resolution_concerns": { "type": "array", "items": { "type": "string" } },
        "suggested_action": {
          "type": "string",
          "enum": ["BUY_YES", "BUY_NO", "MARKET_MAKE", "WATCH", "SKIP"]
        },
        "why_now": { "type": "string" },
        "invalidates_thesis": { "type": "array", "items": { "type": "string" } }
      }
    },

    "HeliusSignal": {
      "type": "object",
      "properties": {
        "signal_type": {
          "type": "string",
          "enum": ["WALLET_FLOW", "DEX_ACTIVITY", "TOKEN_FLOW", "LIQUIDITY_SHIFT",
                   "CLUSTER_BEHAVIOR", "STRESS_SIGNAL", "NARRATIVE_SIGNAL", "STRUCTURAL_SIGNAL"]
        },
        "description": { "type": "string" },
        "assets_involved": { "type": "array", "items": { "type": "string" } },
        "entities_or_wallet_types": { "type": "array", "items": { "type": "string" } },
        "time_window": { "type": "string" },
        "anomaly_score": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "relevance_score": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "causality_score": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "persistence_score": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "quality_score": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "urgency_score": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "manipulation_risk": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "tradability_score": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "counterpoints": { "type": "array", "items": { "type": "string" } }
      }
    },

    "HeliusIntelligence": {
      "type": "object",
      "properties": {
        "market_relevance": {
          "type": "string",
          "enum": ["DIRECT", "INDIRECT", "THEMATIC", "WEAK", "NONE"]
        },
        "market_relevance_reason": { "type": "string" },
        "headline": { "type": "string" },
        "plain_english": { "type": "string" },
        "why_it_matters": { "type": "string" },
        "why_it_may_not_matter": { "type": "string" },
        "detected_signals": { "type": "array", "items": { "$ref": "#/definitions/HeliusSignal" } },
        "aggregate_assessment": {
          "type": "object",
          "properties": {
            "overall_signal_strength": { "type": "number" },
            "overall_confidence": { "type": "number" },
            "overall_urgency": { "type": "number" },
            "false_positive_risk": { "type": "number" },
            "decision_usefulness": { "type": "number" }
          }
        },
        "claude_guidance": {
          "type": "object",
          "properties": {
            "recommendation": { "type": "string", "enum": ["ACTIONABLE", "MONITOR", "IGNORE"] },
            "suggested_effect_on_claude_probability": {
              "type": "string",
              "enum": ["STRONG_UP", "MODEST_UP", "NEUTRAL", "MODEST_DOWN", "STRONG_DOWN"]
            },
            "how_claude_should_use_this": { "type": "string" },
            "position_sizing_impact": {
              "type": "string",
              "enum": ["NONE", "SMALL_REDUCTION", "MODERATE_REDUCTION", "NO_CHANGE", "MODEST_INCREASE"]
            },
            "time_sensitivity": {
              "type": "string",
              "enum": ["IMMEDIATE", "SOON", "NORMAL", "LOW"]
            }
          }
        },
        "risks_and_limits": {
          "type": "object",
          "properties": {
            "main_risks": { "type": "array", "items": { "type": "string" } },
            "ambiguities": { "type": "array", "items": { "type": "string" } },
            "what_would_confirm": { "type": "array", "items": { "type": "string" } },
            "what_would_invalidate": { "type": "array", "items": { "type": "string" } }
          }
        },
        "final_alpha_statement": { "type": "string" }
      }
    },

    "TradeDecision": {
      "type": "object",
      "required": ["decision", "conviction_tier", "fair_probability_yes", "decision_memo"],
      "properties": {
        "decision": {
          "type": "string",
          "enum": ["BUY_YES", "BUY_NO", "POST_PASSIVE_BID", "POST_PASSIVE_ASK",
                   "REDUCE", "EXIT", "WATCH", "SKIP"]
        },
        "conviction_tier": {
          "type": "string",
          "enum": ["LOW", "MEDIUM", "HIGH", "EXTREME"]
        },
        "fair_probability_yes": { "type": "number" },
        "market_implied_probability": { "type": "number" },
        "gross_edge": { "type": "number" },
        "penalties": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "confidence_adjusted_edge": { "type": "number" },
        "position_size_pct": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "position_size_reasoning": { "type": "string" },
        "execution_style": {
          "type": "string",
          "enum": ["PASSIVE", "AGGRESSIVE", "STAGED", "NONE"]
        },
        "entry": { "type": "string" },
        "scale_in": { "type": "string" },
        "take_profit": { "type": "string" },
        "stop_loss": { "type": "string" },
        "cancel_conditions": { "type": "array", "items": { "type": "string" } },
        "thesis_summary": { "type": "string" },
        "why_now": { "type": "string" },
        "key_drivers": { "type": "array", "items": { "type": "string" } },
        "what_market_may_be_missing": { "type": "array", "items": { "type": "string" } },
        "primary_risks": { "type": "array", "items": { "type": "string" } },
        "resolution_concerns": { "type": "array", "items": { "type": "string" } },
        "invalidators": { "type": "array", "items": { "type": "string" } },
        "portfolio_impact": { "type": "string" },
        "brain_contributions": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "hard_block_triggered": { "type": "boolean" },
        "triggered_blocks": { "type": "array", "items": { "type": "string" } },
        "signals_to_watch": { "type": "array", "items": { "type": "string" } },
        "reevaluation_triggers": { "type": "array", "items": { "type": "string" } },
        "review_deadline": { "type": "string" },
        "decision_memo": { "type": "string" }
      }
    }
  }
}
